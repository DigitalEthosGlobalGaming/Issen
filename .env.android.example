# Public client SDK key only; never put a secret API key or service account here.
# free is the mobile default. Set premium for a build-granted beta (no purchase needed).
VITE_GAME_EDITION=free
# Keep false for the closed-testing release. Opt in only when resuming billing.
VITE_PREMIUM_ENABLED=false
VITE_REVENUECAT_ANDROID_KEY=
# Local debug builds only. Google Play releases must use goog_ keys.
VITE_PREMIUM_TEST_STORE=false
