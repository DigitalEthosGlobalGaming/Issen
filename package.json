{
  "name": "issen",
  "version": "1.69.32",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write src tests index.html *.ts *.json",
    "format:check": "prettier --check src tests index.html *.ts *.json",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --base=/Issen/",
    "build:android": "npm run typecheck && vite build --mode android",
    "android:sync": "npm run build:android && cap sync android",
    "android:open": "cap open android",
    "android:run": "npm run android:sync && cap run android",
    "android:apk": "npm run android:sync && node scripts/android-build.mjs apk",
    "android:bundle": "npm run android:sync && node scripts/android-build.mjs bundle",
    "test:android-web": "npm run build:android && playwright test --config playwright.android.config.ts",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test",
    "build:verification": "node scripts/build-verification.mjs",
    "test:production": "npm run build:verification && playwright test --config playwright.production.config.ts",
    "build:branch": "node scripts/build-pages.mjs",
    "build:develop": "node scripts/build-pages.mjs --branch develop",
    "test-performance": "node tests/performance/run.mjs",
    "test:performance-tools": "node --test tests/performance/*.test.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.63.0",
    "magic-string": "1.4.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "dependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/core": "8.4.3",
    "@fontsource/shippori-mincho-b1": "5.3.0",
    "@revenuecat/purchases-capacitor": "13.6.1",
    "pixi.js": "8.22.0"
  }
}
