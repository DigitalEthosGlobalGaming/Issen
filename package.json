{
  "name": "issen",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "format": "prettier --write src tests index.html *.ts *.json",
    "format:check": "prettier --check src tests index.html *.ts *.json",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "build": "npm run typecheck && vite build",
    "build:pages": "npm run typecheck && vite build --base=/Issen/",
    "preview": "vite preview",
    "test": "node --test tests/unit/*.test.mjs",
    "test:browser": "playwright test",
    "test:production": "npm run build && playwright test --config playwright.production.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
